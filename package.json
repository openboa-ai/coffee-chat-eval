{
  "name": "@openboa-ai/coffee-chat-eval",
  "private": true,
  "version": "2026.8.12",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run policy:install && node --experimental-strip-types --test tests/*.test.*",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "git config core.hooksPath .githooks",
    "build": "tsc --noEmit",
    "security:scan": "gitleaks git --redact --no-banner .",
    "dry-run": "node --experimental-strip-types src/cli.ts dry-run",
    "canary:check": "python3 -m py_compile evals/protocol-canary/tests/verify.py evals/protocol-canary/tests/resources.py evals/ifeval-smoke/tests/verify.py evals/ifeval-smoke/tests/resources.py && sh -n evals/protocol-canary/solution/solve.sh evals/protocol-canary/tests/test.sh evals/ifeval-smoke/solution/solve.sh evals/ifeval-smoke/tests/test.sh",
    "canary:calibrate": "node --experimental-strip-types src/canary-cli.ts calibrate",
    "benchmark:calibrate": "node --experimental-strip-types src/canary-cli.ts benchmark-calibrate",
    "pcda:calibrate": "node --experimental-strip-types src/pcda-cli.ts calibrate --oracle-result $PWD/tests/fixtures/pcda-calibration/oracle-result.json --noop-result $PWD/tests/fixtures/pcda-calibration/noop-result.json",
    "smoke": "node --experimental-strip-types --test tests/smoke.test.ts",
    "policy:install": "node .github/policy-bootstrap.mjs && npm ci --ignore-scripts --prefix .github/policy-parser",
    "ci:policy": "npm run policy:install && node --test tests/workflow-policy.test.mjs && node .github/ci-policy.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
