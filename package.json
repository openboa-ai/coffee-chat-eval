{
  "name": "@openboa-ai/coffee-chat-eval",
  "private": true,
  "version": "2026.8.9",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
