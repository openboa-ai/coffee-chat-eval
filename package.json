{
  "name": "@openboa-ai/coffee-chat-eval",
  "private": true,
  "version": "2026.8.12",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc --noEmit",
    "dry-run": "node --experimental-strip-types src/cli.ts dry-run",
    "canary:check": "python3 -m py_compile integrations/harbor/coffee_chat_codex.py evals/protocol-canary/tests/verify.py evals/ifeval-smoke/tests/verify.py && sh -n evals/protocol-canary/solution/solve.sh evals/protocol-canary/tests/test.sh evals/ifeval-smoke/solution/solve.sh evals/ifeval-smoke/tests/test.sh",
    "canary:calibrate": "node --experimental-strip-types src/canary-cli.ts calibrate",
    "canary:codex": "node --experimental-strip-types src/canary-cli.ts codex",
    "benchmark:smoke": "node --experimental-strip-types src/canary-cli.ts benchmark",
    "benchmark:calibrate": "node --experimental-strip-types src/canary-cli.ts benchmark-calibrate",
    "smoke": "node --experimental-strip-types --test tests/smoke.test.ts",
    "ci:policy": "node .github/ci-policy.mjs"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "prettier": "3.9.6",
    "typescript": "5.9.2"
  }
}
