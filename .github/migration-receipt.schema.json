{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openboa-ai/coffee-chat-eval/blob/main/.github/migration-receipt.schema.json",
  "title": "Coffee Chat migration execution receipt",
  "type": "object",
  "required": [
    "schema",
    "target_owner",
    "task",
    "objective",
    "projection_sha256",
    "equality_receipt_sha256",
    "execution_class",
    "oracle",
    "action_evidence"
  ],
  "properties": {
    "schema": { "const": "coffee-chat/migration-execution-receipt" },
    "target_owner": { "$ref": "#/$defs/repository" },
    "task": { "type": "string", "pattern": "^task-[1-9][0-9]*$" },
    "objective": { "$ref": "#/$defs/nonEmptyString" },
    "projection_sha256": { "$ref": "#/$defs/sha256Digest" },
    "equality_receipt_sha256": { "$ref": "#/$defs/sha256Digest" },
    "execution_class": { "enum": ["fixture_only", "isolated"] },
    "oracle": { "const": "local_deterministic_checks" },
    "action_evidence": {
      "type": "object",
      "required": ["migrate", "rewrite", "exclude"],
      "properties": {
        "migrate": {
          "type": "array",
          "items": { "$ref": "#/$defs/migrateEvidence" }
        },
        "rewrite": {
          "type": "array",
          "items": { "$ref": "#/$defs/rewriteEvidence" }
        },
        "exclude": {
          "type": "array",
          "items": { "$ref": "#/$defs/excludeEvidence" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": { "type": "string", "minLength": 1 },
    "migrateEvidence": {
      "type": "object",
      "required": [
        "source_repository",
        "source_ref",
        "source_commit",
        "source_path",
        "source_blob_oid",
        "source_sha256",
        "target_path",
        "target_blob_oid",
        "target_sha256",
        "verification"
      ],
      "properties": {
        "source_repository": { "$ref": "#/$defs/repository" },
        "source_ref": { "$ref": "#/$defs/nonEmptyString" },
        "source_commit": { "$ref": "#/$defs/gitOid" },
        "source_path": { "$ref": "#/$defs/path" },
        "source_blob_oid": { "$ref": "#/$defs/gitOid" },
        "source_sha256": { "$ref": "#/$defs/sha256Digest" },
        "target_path": { "$ref": "#/$defs/path" },
        "target_blob_oid": { "$ref": "#/$defs/gitOid" },
        "target_sha256": { "$ref": "#/$defs/sha256Digest" },
        "verification": { "const": "byte_and_blob_equal" }
      },
      "additionalProperties": false
    },
    "rewriteEvidence": {
      "type": "object",
      "required": [
        "source_repository",
        "source_ref",
        "source_commit",
        "source_path",
        "target_path_or_surface",
        "source_objective_or_failure_mode",
        "replacement_observable_oracle",
        "verification"
      ],
      "properties": {
        "source_repository": { "$ref": "#/$defs/repository" },
        "source_ref": { "$ref": "#/$defs/nonEmptyString" },
        "source_commit": { "$ref": "#/$defs/gitOid" },
        "source_path": { "$ref": "#/$defs/path" },
        "target_path_or_surface": { "$ref": "#/$defs/path" },
        "source_objective_or_failure_mode": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "replacement_observable_oracle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "verification": { "const": "observable_oracle_passed" }
      },
      "additionalProperties": false
    },
    "excludeEvidence": {
      "type": "object",
      "required": [
        "source_repository",
        "source_ref",
        "source_commit",
        "source_path",
        "checked_target_paths",
        "verification"
      ],
      "properties": {
        "source_repository": { "$ref": "#/$defs/repository" },
        "source_ref": { "$ref": "#/$defs/nonEmptyString" },
        "source_commit": { "$ref": "#/$defs/gitOid" },
        "source_path": { "$ref": "#/$defs/path" },
        "checked_target_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "verification": { "const": "absent_from_target" }
      },
      "additionalProperties": false
    }
  }
}
