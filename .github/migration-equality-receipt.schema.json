{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openboa-ai/coffee-chat-eval/blob/main/.github/migration-equality-receipt.schema.json",
  "title": "Coffee Chat migration equality inputs",
  "type": "object",
  "required": [
    "schema",
    "target_owner",
    "task",
    "objective",
    "ledger_sha256",
    "generator_sha256",
    "objective_selection_sha256",
    "projection_sha256",
    "changed_surface_classification_sha256"
  ],
  "properties": {
    "schema": { "const": "coffee-chat/migration-equality-inputs" },
    "target_owner": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "task": { "type": "string", "pattern": "^task-[1-9][0-9]*$" },
    "objective": { "type": "string", "minLength": 1 },
    "ledger_sha256": { "$ref": "#/$defs/sha256Hex" },
    "generator_sha256": { "$ref": "#/$defs/sha256Hex" },
    "objective_selection_sha256": { "$ref": "#/$defs/sha256Hex" },
    "projection_sha256": { "$ref": "#/$defs/sha256Hex" },
    "changed_surface_classification_sha256": {
      "$ref": "#/$defs/sha256Hex"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
