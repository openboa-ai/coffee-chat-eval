{
  "schema": "coffee-chat/merge-policy",
  "auto_merge": {
    "provider": "github-native",
    "required_checks": true,
    "verified_members_only": true
  },
  "merge_method": "squash",
  "required_approvals": 0,
  "review_policy": {
    "default_required_approvals": 0,
    "sensitive_paths_use_human_team_reviewer": true
  },
  "eligible_author_associations": ["OWNER", "MEMBER"],
  "eligible_bot_logins": ["dependabot[bot]"],
  "protected_paths": [
    ".github/**",
    ".githooks/**",
    ".gitleaksignore",
    ".gitleaks.toml",
    "AGENTS.md",
    "CODEOWNERS",
    "SECURITY.md",
    "integrations/harbor/**",
    "src/harbor.ts",
    "src/pcda-harbor.ts",
    "src/pcda-runner.ts",
    "src/registry.ts",
    "src/runner.ts"
  ],
  "required_contexts": [
    "aggregate",
    "dependency review",
    "Secret boundary",
    "JavaScript-TypeScript"
  ]
}
